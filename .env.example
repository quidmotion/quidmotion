# Database
DB_PROVIDER=local
DB_PATH=./data/quidmotion.db
# DATABASE_URL=postgresql://...  # when DB_PROVIDER=supabase

# Supabase (required on Vercel for KYC document uploads — Storage is not local disk)
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   # server only; never expose to the browser
# Optional override: supabase | local (default: supabase when URL+key present)
# KYC_STORAGE=supabase

# Auth
AUTH_PROVIDER=local
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_TTL_DAYS=7

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=QuidMotion

# Feature flags (true/false)
FF_LEAD_MAGNET=true
FF_REFERRALS=true
FF_LIVE_CRYPTO_PRICES=true
FF_WALLET_CONNECT=false
FF_ADMIN_CMS=true
FF_EXIT_INTENT_MODAL=true

# Pricing: live (CoinGecko) or mock fallback
PRICE_SOURCE=live

# Transactional email
# Admin → Settings chooses the transport: Gmail SMTP or Custom domain (Resend).
# From-address is the no-reply email set in Admin → Settings.
#
# Custom domain (Resend): no-reply must be on a domain verified in Resend.
# RESEND_API_KEY=re_xxxxxxxx
#
# Gmail SMTP: Google App Password (not the account password). 2FA required.
# No-reply should be this Gmail mailbox (or a Google alias of it).
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional: protect /api/cron/growth
# CRON_SECRET=long-random-string

# Argon2 / scrypt (optional overrides)
# ARGON2_MEMORY_COST=19456
