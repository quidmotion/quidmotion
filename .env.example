# Database
DB_PROVIDER=local
DB_PATH=./data/quidmotion.db
# DATABASE_URL=postgresql://...  # when DB_PROVIDER=supabase

# Auth
AUTH_PROVIDER=local
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_TTL_DAYS=7

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=QuidMotion

# Feature flags (true/false)
FF_LEAD_MAGNET=true
FF_REFERRALS=true
FF_LIVE_CRYPTO_PRICES=true
FF_WALLET_CONNECT=false
FF_ADMIN_CMS=true
FF_EXIT_INTENT_MODAL=true

# Pricing: live (CoinGecko) or mock fallback
PRICE_SOURCE=live

# Optional: deliver transactional email via Resend
# RESEND_API_KEY=re_xxxxxxxx
# Without this key, emails are written to data/emails/ and email_outbox

# Optional: protect /api/cron/growth
# CRON_SECRET=long-random-string

# Argon2 / scrypt (optional overrides)
# ARGON2_MEMORY_COST=19456
